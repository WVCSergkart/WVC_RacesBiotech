							</li>
							<!-- <li Class="PatchOperationRemove"> -->
								<!-- <xpath>/Defs/GeneDef[@WVC_XaG_XenotypeRemoveTag="GolemMasters"]</xpath> -->
								<!-- <success>Always</success> -->
							<!-- </li> -->

						</operations>
					</caseTrue>
				</li>
				<li Class="WVC_XenotypesAndGenes.PatchOperationOptional">
					<settingName>disableXenotypes_Hivemind</settingName>
					<caseTrue Class="PatchOperationSequence">
						<operations>

							<li Class="PatchOperationRemove">
								<xpath>/Defs/XenotypeDef[@WVC_XaG_XenotypeRemoveTag="Hivemind"]</xpath>
								<success>Always</success>
							</li>

						</operations>
					</caseTrue>
				</li>
				<li Class="WVC_XenotypesAndGenes.PatchOperationOptional">
					<settingName>disableXenotypes_Bloodeaters</settingName>
					<caseTrue Class="PatchOperationSequence">
						<operations>

							<li Class="PatchOperationRemove">
								<xpath>/Defs/GeneDef[defName="WVC_Chimera" or defName="WVC_FleshmassNucleus" or defName="WVC_VoidMechlink"]/modExtensions/li[@Class="WVC_XenotypesAndGenes.GeneExtension_Undead"]/xenotypeDef</xpath>
								<success>Always</success>
							</li>

							<li Class="PatchOperationRemove">
								<xpath>/Defs/XenotypeDef[@WVC_XaG_XenotypeRemoveTag="Bloodeaters"]</xpath>
								<success>Always</success>
							</li>
							<!-- <li Class="PatchOperationRemove"> -->
								<!-- <xpath>/Defs/GeneDef[@WVC_XaG_XenotypeRemoveTag="Bloodeaters"]</xpath> -->
								<!-- <success>Always</success> -->
							<!-- </li> -->

						</operations>
					</caseTrue>
				</li>
				<li Class="WVC_XenotypesAndGenes.PatchOperationOptional">
					<settingName>disableXenotypes_Misc</settingName>
					<caseTrue Class="PatchOperationSequence">
						<operations>

							<li Class="PatchOperationRemove">
								<xpath>/Defs/WVC_XenotypesAndGenes.ThrallDef[@WVC_XaG_XenotypeRemoveTag="NonSpecificOrMisc" or @WVC_XaG_XenotypeRemoveTag="MutantMakers"]/xenotypeDef</xpath>
								<success>Always</success>
							</li>
							<li Class="PatchOperationRemove">
								<xpath>/Defs/WVC_XenotypesAndGenes.XenotypesAndGenesListDef/devXenotypeDefs/li[@WVC_XaG_XenotypeRemoveTag="NonSpecificOrMisc" or @WVC_XaG_XenotypeRemoveTag="MutantMakers"]</xpath>
								<success>Always</success>
							</li>
							<li Class="PatchOperationRemove">
								<xpath>/Defs/XenotypeDef[@WVC_XaG_XenotypeRemoveTag="NonSpecificOrMisc" or @WVC_XaG_XenotypeRemoveTag="MutantMakers"]</xpath>
								<success>Always</success>
							</li>
							<!-- <li Class="PatchOperationRemove"> -->
								<!-- <xpath>/Defs/GeneDef[@WVC_XaG_XenotypeRemoveTag="NonSpecificOrMisc"]</xpath> -->
								<!-- <success>Always</success> -->
							<!-- </li> -->

						</operations>
					</caseTrue>
				</li>

				<!-- ============================ -->

			</operations>
		</caseTrue>
	</Operation>

</Patch>