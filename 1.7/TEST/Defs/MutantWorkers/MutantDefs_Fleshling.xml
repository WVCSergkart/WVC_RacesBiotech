<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <WVC_XenotypesAndGenes.XaG_MutantDef ParentName="WVC_XenotypesAndGenes_WorkerMutant">
	<defName>WVC_FleshmassDuplicate</defName>
	<label>flesh-duplicate</label>
	<description>A person who was created as a mindless duplicate.\n\nAbout fleshlings: They are created by archites as simple duplicates; they lack their own consciousness and are psychically linked to their originals. Occasionally, they can inherit some of their originals' traits, which will have effects on them. Their only purpose is work.</description>
	<hediff>WVC_FleshmassDuplicate</hediff>
	<deathLetter>One of your flesh-duplicates has died.</deathLetter>
	<deathLetterExtra>Unlike regular colonists, fleshlings do not need to be buried and their death will not upset others. You may choose to bury them should you wish.</deathLetterExtra>
	<namePrefix>fleshling </namePrefix>
	<workDisables>
	  <li>Hunting</li>
	  <li>Violent</li>
	  <li>Shooting</li>
	  <li>Intellectual</li>
	  <!-- <li>ManualSkilled</li> -->
	  <li>Artistic</li>
	</workDisables>
	<geneDefs>
		<!-- <li>Immunity_Strong</li> -->
		<!-- <li>LowSleep</li> -->
		<li>Sterile</li>
		<li>WVC_HeadTentacles0c</li>
		<li>Beard_NoBeardOnly</li>
		<li>Ears_Pointed</li>
		<li>Body_Standard</li>
		<!-- <li>WVC_BodySize_Small</li> -->
		<li MayRequire="oskarpotocki.vanillafactionsexpanded.core">WVC_BodySize_ChildlikeSmall</li>
		<li>Hair_SnowWhite</li>
		<li>WVC_BodyTentacles</li>
		<li>WVC_SkinColor_FleshPink</li>
		<li>WVC_TentacleHands</li>
		<li>WVC_LongTentacleTail</li>
		<!-- <li>WVC_MechaAI_Base</li> -->
		<li>WVC_PredatorPrey_NotTasty</li>
	</geneDefs>
  </WVC_XenotypesAndGenes.XaG_MutantDef>

