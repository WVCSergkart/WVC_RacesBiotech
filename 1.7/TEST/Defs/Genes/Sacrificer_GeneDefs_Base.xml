<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <GeneDef ParentName="WVC_XenotypesAndGenes_GeneFleshmass_Mutations">
	<defName>WVC_Sacrificer</defName>
	<label>sacrificer</label>
	<labelShortAdj>sacrificer</labelShortAdj>
	<description>Carriers of this gene have a special psychic connection with the void. They involuntarily act as a beacon for void energy, slowly consuming those around them. However, this comes with a reward.</description>
	<iconPath>WVC/UI/Genes3/Gene_Sacrificer</iconPath>
	<geneClass>WVC_XenotypesAndGenes.Gene_Sacrificer</geneClass>
	<resourceGizmoType>WVC_XenotypesAndGenes.GeneGizmo_Sacrificer</resourceGizmoType>
	<biostatCpx>7</biostatCpx>
	<biostatArc>3</biostatArc>
	<biostatMet>0</biostatMet>
	<minAgeActive>3</minAgeActive>
	<displayOrderInCategory>-100</displayOrderInCategory>
	<customEffectDescriptions>
		<li>Allows to &lt;color=#8a8ae6&gt;edit xenogenes&lt;/color&gt;.</li>
		<li>While the &lt;color=#8a8ae6&gt;monolith and mechhive&lt;/color&gt; is active, it &lt;color=#8a8ae6&gt;sacrifices&lt;/color&gt; one pawn every few hours.</li>
		<!-- <li>The sacrifice is rewarded. The reward can be chosen from three presets: &lt;color=#8a8ae6&gt;biotech, anomaly, and odyssey&lt;/color&gt;.</li> -->
		<li>The target is selected relative to the selected gene mode.</li>
		<li>Each pawn killed in this way is exchanged for a reward determined by the mode.</li>
		<!-- <li>Gene &lt;color=#8a8ae6&gt;metabolism&lt;/color&gt; depends on the number of pawns &lt;color=#8a8ae6&gt;sacrificed&lt;/color&gt;.</li> -->
	</customEffectDescriptions>
	<exclusionTags>
	  <li>WVC_Chimera</li>
	  <li>WVC_Gene_Sacrificer</li>
	  <li>WVC_XenogenesEditors</li>
	  <li>WVC_Energyshifter_XenogenesEditor</li>
	</exclusionTags>
	<modExtensions>
		<li Class="WVC_XenotypesAndGenes.GeneExtension_Giver">
			<jobDef>WVC_Sacrificer_SelfSacrifice</jobDef>
		</li>
	</modExtensions>
  </GeneDef>

  <!-- ============================================ -->

  <JobDef ParentName="WVC_XenotypesAndGenes_JobDef_Base">
	<defName>WVC_Sacrificer_SelfSacrifice</defName>
	<driverClass>WVC_XenotypesAndGenes.JobDriver_SelfSacrifice</driverClass>
	<reportString>self sacrifice.</reportString>
  </JobDef>

</Defs>